{
  "name": "shmuel",
  "version": "0.1.0",
  "private": true,
  "description": "Shmuel - personal AI chat with adaptive memory and transparent learning",
  "scripts": {
    "dev": "pnpm --filter @shmuel/web dev",
    "build": "pnpm --filter @shmuel/web build",
    "start": "pnpm --filter @shmuel/web start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "desktop:dev": "pnpm --filter @shmuel/desktop dev",
    "desktop:build": "pnpm --filter @shmuel/desktop build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
