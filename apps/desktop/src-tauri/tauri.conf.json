{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "שמואל",
  "version": "0.1.0",
  "identifier": "ai.shmuel.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://shmuel.ai",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "שמואל",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "url": "https://shmuel.ai",
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": null
    },
    "windows": {
      "wix": {
        "language": "he-IL"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://shmuel.ai/api/updater/{{target}}/{{arch}}/{{current_version}}"],
      "dialog": true
    }
  }
}
